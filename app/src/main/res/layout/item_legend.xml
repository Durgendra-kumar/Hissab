<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <View android:id="@+id/legendDot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/bg_dot" />
    <TextView android:id="@+id/tvLegendName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:textColor="@color/text" android:textSize="14sp" tools:text="🛒 Grocery" />
    <TextView android:id="@+id/tvLegendPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="12dp" android:textColor="@color/mute" android:textSize="13sp" tools:text="35%" />
    <TextView android:id="@+id/tvLegendAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold" tools:text="₹3,450.00" />
</LinearLayout>